{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Alhangeul",
  "version": "0.1.3",
  "identifier": "io.github.postmelee.alhangeul",
  "build": {
    "beforeDevCommand": "cd ../.. && pnpm --filter @postmelee/alhangeul-studio-host dev",
    "beforeBuildCommand": "cd ../.. && pnpm run build:before-tauri",
    "devUrl": "http://127.0.0.1:7700",
    "frontendDist": "../../studio-host/dist"
  },
  "app": {
    "windows": [
      {
        "title": "Alhangeul",
        "label": "main",
        "url": "index.html",
        "width": 1280,
        "height": 900,
        "minWidth": 960,
        "minHeight": 720
      }
    ],
    "security": {
      "csp": "default-src 'self'; base-uri 'none'; object-src 'none'; form-action 'none'; frame-ancestors 'self'; connect-src 'self' ipc: http://ipc.localhost; img-src 'self' data: blob: asset: http://asset.localhost; font-src 'self' data: asset: http://asset.localhost; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-eval' 'wasm-unsafe-eval'; worker-src 'self' blob:",
      "devCsp": "default-src 'self' http://127.0.0.1:7700 ws://127.0.0.1:7700; base-uri 'none'; object-src 'none'; form-action 'none'; frame-ancestors 'self'; connect-src 'self' http://127.0.0.1:7700 ws://127.0.0.1:7700 ipc: http://ipc.localhost; img-src 'self' data: blob: asset: http://asset.localhost http://127.0.0.1:7700; font-src 'self' data: asset: http://asset.localhost http://127.0.0.1:7700; style-src 'self' 'unsafe-inline' http://127.0.0.1:7700; script-src 'self' 'unsafe-eval' 'wasm-unsafe-eval' http://127.0.0.1:7700; worker-src 'self' blob: http://127.0.0.1:7700"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "postmelee",
    "shortDescription": "Open desktop editor for HWP and HWPX documents",
    "longDescription": "Alhangeul opens and edits HWP/HWPX documents, saves HWP/HWPX documents, and exports PDF files.",
    "category": "Productivity",
    "copyright": "Alhangeul contributors",
    "icon": [
      "../../../assets/logo/logo-32.png",
      "../../../assets/logo/logo-128.png",
      "../../../assets/logo/logo-256.png",
      "../../../assets/logo/logo-512.png",
      "../../../assets/logo/favicon.ico"
    ],
    "resources": {
      "../../../assets/fonts/FONTS.md": "licenses/fonts/FONTS.md",
      "../../../assets/fonts/licenses/NotoSansKR-OFL-1.1.txt": "licenses/fonts/NotoSansKR-OFL-1.1.txt",
      "../../../assets/fonts/licenses/NotoSerifKR-OFL-1.1.txt": "licenses/fonts/NotoSerifKR-OFL-1.1.txt",
      "../../../assets/fonts/licenses/Cafe24Ssurround-LICENSE.pdf": "licenses/fonts/Cafe24Ssurround-LICENSE.pdf",
      "../../../assets/fonts/licenses/Cafe24Supermagic-LICENSE.pdf": "licenses/fonts/Cafe24Supermagic-LICENSE.pdf",
      "../../../assets/fonts/licenses/D2Coding-OFL.txt": "licenses/fonts/D2Coding-OFL.txt",
      "../../../assets/fonts/licenses/GowunBatang-OFL.txt": "licenses/fonts/GowunBatang-OFL.txt",
      "../../../assets/fonts/licenses/GowunDodum-OFL.txt": "licenses/fonts/GowunDodum-OFL.txt",
      "../../../assets/fonts/licenses/HappinessSans-LICENSE.pdf": "licenses/fonts/HappinessSans-LICENSE.pdf",
      "../../../assets/fonts/licenses/LPPL-1.3c.txt": "licenses/fonts/LPPL-1.3c.txt",
      "../../../assets/fonts/licenses/LatinModernMath-GUST-FONT-LICENSE.txt": "licenses/fonts/LatinModernMath-GUST-FONT-LICENSE.txt",
      "../../../assets/fonts/licenses/NanumGothic-OFL.txt": "licenses/fonts/NanumGothic-OFL.txt",
      "../../../assets/fonts/licenses/NanumGothicCoding-OFL.txt": "licenses/fonts/NanumGothicCoding-OFL.txt",
      "../../../assets/fonts/licenses/NanumMyeongjo-OFL.txt": "licenses/fonts/NanumMyeongjo-OFL.txt",
      "../../../assets/fonts/licenses/NotoCJKSerif-OFL.txt": "licenses/fonts/NotoCJKSerif-OFL.txt",
      "../../../assets/fonts/licenses/NotoSansKR-OFL.txt": "licenses/fonts/NotoSansKR-OFL.txt",
      "../../../assets/fonts/licenses/Pretendard-OFL.txt": "licenses/fonts/Pretendard-OFL.txt",
      "../../../assets/fonts/licenses/SIL-OFL-1.1.txt": "licenses/fonts/SIL-OFL-1.1.txt",
      "../../../assets/fonts/licenses/SpoqaHanSans-OFL.txt": "licenses/fonts/SpoqaHanSans-OFL.txt",
      "../../../assets/fonts/licenses/font-notices.json": "licenses/fonts/font-notices.json",
      "../../../LICENSE": "licenses/Alhangeul-LICENSE.txt",
      "../../../assets/licenses/dependency-notices.zip": "licenses/dependency-notices.zip",
      "resources/install-privacy.txt": "privacy/install-privacy.txt"
    },
    "fileAssociations": [
      {
        "ext": ["hwp"],
        "name": "Alhangeul.hwp",
        "description": "Hangul Word Processor document",
        "mimeType": "application/x-hwp"
      },
      {
        "ext": ["hwpx"],
        "name": "Alhangeul.hwpx",
        "description": "Hangul Word Processor XML document",
        "mimeType": "application/x-hwpx"
      }
    ],
    "windows": {
      "wix": {
        "template": "windows/main.wxs"
      },
      "nsis": {
        "installMode": "currentUser",
        "startMenuFolder": "Alhangeul",
        "installerHooks": "windows/nsis-hooks.nsh"
      }
    },
    "linux": {
      "deb": {
        "desktopTemplate": "linux/main.desktop",
        "depends": ["shared-mime-info"],
        "postInstallScript": "linux/update-mime-database.sh",
        "postRemoveScript": "linux/update-mime-database-remove.sh",
        "files": {
          "/usr/lib/alhangeul/alhangeul-thumbnailer": "linux/thumbnail-resources/alhangeul-thumbnailer",
          "/usr/share/thumbnailers/alhangeul.thumbnailer": "linux/alhangeul.thumbnailer",
          "/usr/share/mime/packages/alhangeul-hwpx.xml": "linux/alhangeul-hwpx.xml"
        }
      },
      "rpm": {
        "desktopTemplate": "linux/main.desktop",
        "depends": ["shared-mime-info"],
        "postInstallScript": "linux/update-mime-database.sh",
        "postRemoveScript": "linux/update-mime-database-remove.sh",
        "files": {
          "/usr/lib/alhangeul/alhangeul-thumbnailer": "linux/thumbnail-resources/alhangeul-thumbnailer",
          "/usr/share/thumbnailers/alhangeul.thumbnailer": "linux/alhangeul.thumbnailer",
          "/usr/share/mime/packages/alhangeul-hwpx.xml": "linux/alhangeul-hwpx.xml"
        }
      }
    },
    "licenseFile": "resources/install-privacy.rtf"
  }
}
