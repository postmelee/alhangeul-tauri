{
  "name": "alhangeul-tauri",
  "version": "0.1.0",
  "private": true,
  "description": "Alhangeul desktop app for HWP and HWPX documents",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "check:desktop-artifacts": "node scripts/verify-desktop-artifacts.mjs",
    "check:product-boundary": "node scripts/check-product-boundary.mjs",
    "check:product-version": "node scripts/check-product-version.mjs",
    "check:release-metadata": "node scripts/check-release-metadata.mjs",
    "check:rhwp-pin": "node scripts/verify-rhwp-pin.mjs",
    "create:release-checksums": "node scripts/create-release-checksums.mjs",
    "build:studio": "pnpm --filter @postmelee/alhangeul-studio-host build",
    "build:before-tauri": "pnpm run build:studio",
    "build:desktop": "pnpm --filter alhangeul-desktop build",
    "tauri": "pnpm --filter alhangeul-desktop tauri",
    "test": "pnpm run test:upstream && pnpm run test:studio && pnpm run test:desktop",
    "test:automation": "node --test tests/desktop-artifacts.test.mjs tests/actions-workflows.test.mjs tests/product-version.test.mjs tests/release-metadata.test.mjs tests/release-checksums.test.mjs",
    "test:upstream": "node --test tests/update-upstream.test.mjs tests/rhwp-pin.test.mjs tests/rhwp-baseline.test.mjs",
    "test:studio": "pnpm --filter @postmelee/alhangeul-studio-host test",
    "test:desktop": "cd apps/desktop/src-tauri && cargo test",
    "clippy:desktop": "cd apps/desktop/src-tauri && cargo clippy -- -D warnings"
  }
}
